<mxfile host="app.diagrams.net" modified="2026-08-10T00:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="fyralis-ingestion" name="3 Planes - 9 Layers">
    <mxGraphModel dx="2600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="&lt;b&gt;Fyralis Data Ingestion System&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;3 planes · 9 layers · input/output sequence&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="570" y="15" width="1500" height="65" as="geometry"/>
        </mxCell>

        <mxCell id="external" value="&lt;b&gt;EXTERNAL SOURCES&lt;/b&gt;&lt;br&gt;&lt;br&gt;Slack · Notion&lt;br&gt;Jira · GitHub&lt;br&gt;Other providers" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="300" width="145" height="160" as="geometry"/>
        </mxCell>

        <mxCell id="plane1" value="&lt;b&gt;PLANE 1 — PERCEPTION&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;What did external systems emit, and how was it observed?&lt;/font&gt;" style="swimlane;html=1;rounded=1;startSize=62;horizontal=1;fillColor=#dae8fc;swimlaneFillColor=#f7fbff;strokeColor=#6c8ebf;fontSize=18;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="190" y="100" width="1180" height="620" as="geometry"/>
        </mxCell>
        <mxCell id="l1" value="&lt;b&gt;1. Connector Definition&lt;br&gt;and Admission&lt;/b&gt;&lt;hr&gt;&lt;b&gt;Input&lt;/b&gt;&lt;br&gt;Manifest + source capabilities&lt;br&gt;&lt;br&gt;&lt;b&gt;Process&lt;/b&gt;&lt;br&gt;Validate contract, records and sync modes&lt;br&gt;&lt;br&gt;&lt;b&gt;Output&lt;/b&gt;&lt;br&gt;Admitted connector definition" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=11;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;shadow=1;" vertex="1" parent="plane1"><mxGeometry x="20" y="90" width="205" height="330" as="geometry"/></mxCell>
        <mxCell id="l2" value="&lt;b&gt;2. Installation, Authority&lt;br&gt;and Lifecycle&lt;/b&gt;&lt;hr&gt;&lt;b&gt;Input&lt;/b&gt;&lt;br&gt;Tenant + credentials + permissions&lt;br&gt;&lt;br&gt;&lt;b&gt;Process&lt;/b&gt;&lt;br&gt;Establish scope, authority and state&lt;br&gt;&lt;br&gt;&lt;b&gt;Output&lt;/b&gt;&lt;br&gt;Runnable tenant installation" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=11;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;shadow=1;" vertex="1" parent="plane1"><mxGeometry x="250" y="90" width="205" height="330" as="geometry"/></mxCell>
        <mxCell id="l3" value="&lt;b&gt;3. Source Acquisition&lt;br&gt;and Reconciliation&lt;/b&gt;&lt;hr&gt;&lt;b&gt;Input&lt;/b&gt;&lt;br&gt;Webhook, poll, stream or backfill&lt;br&gt;&lt;br&gt;&lt;b&gt;Process&lt;/b&gt;&lt;br&gt;Track cursors, revisions and deletion&lt;br&gt;&lt;br&gt;&lt;b&gt;Output&lt;/b&gt;&lt;br&gt;Provider revision envelope" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=11;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;shadow=1;" vertex="1" parent="plane1"><mxGeometry x="480" y="90" width="205" height="330" as="geometry"/></mxCell>
        <mxCell id="l4" value="&lt;b&gt;4. Raw Evidence&lt;br&gt;Transport&lt;/b&gt;&lt;hr&gt;&lt;b&gt;Input&lt;/b&gt;&lt;br&gt;Provider revision + raw payload&lt;br&gt;&lt;br&gt;&lt;b&gt;Process&lt;/b&gt;&lt;br&gt;Store bytes with source and revision metadata&lt;br&gt;&lt;br&gt;&lt;b&gt;Output&lt;/b&gt;&lt;br&gt;Raw object + evidence pointer" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=11;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;shadow=1;" vertex="1" parent="plane1"><mxGeometry x="710" y="90" width="205" height="330" as="geometry"/></mxCell>
        <mxCell id="l5" value="&lt;b&gt;5. Normalization and&lt;br&gt;Observation Settlement&lt;/b&gt;&lt;hr&gt;&lt;b&gt;Input&lt;/b&gt;&lt;br&gt;Raw provider object&lt;br&gt;&lt;br&gt;&lt;b&gt;Process&lt;/b&gt;&lt;br&gt;Normalize and persist common contracts&lt;br&gt;&lt;br&gt;&lt;b&gt;Output&lt;/b&gt;&lt;br&gt;Evidence + observation + identity event" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=11;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;shadow=1;" vertex="1" parent="plane1"><mxGeometry x="940" y="90" width="215" height="330" as="geometry"/></mxCell>
        <mxCell id="p1io" value="&lt;b&gt;PLANE INPUT&lt;/b&gt; — External source emissions&amp;nbsp;&amp;nbsp; → &amp;nbsp;&amp;nbsp;&lt;b&gt;PLANE OUTPUT&lt;/b&gt; — Immutable evidence + normalized observations" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#eaf3ff;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="plane1"><mxGeometry x="20" y="470" width="1135" height="75" as="geometry"/></mxCell>

        <mxCell id="plane2" value="&lt;b&gt;PLANE 2 — IDENTITY AND KNOWLEDGE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;What does the evidence refer to, and what does it claim?&lt;/font&gt;" style="swimlane;html=1;rounded=1;startSize=62;horizontal=1;fillColor=#d5e8d4;swimlaneFillColor=#f8fcf7;strokeColor=#82b366;fontSize=18;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1400" y="100" width="500" height="620" as="geometry"/>
        </mxCell>
        <mxCell id="l6" value="&lt;b&gt;6. Entity Resolution&lt;/b&gt;&lt;hr&gt;&lt;b&gt;Input&lt;/b&gt;&lt;br&gt;Observation + evidence + references + hints&lt;br&gt;&lt;br&gt;&lt;b&gt;Process&lt;/b&gt;&lt;br&gt;Register mentions, rank candidates, preserve ambiguity&lt;br&gt;&lt;br&gt;&lt;b&gt;Output&lt;/b&gt;&lt;br&gt;Complete or partial identity snapshot" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=11;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;shadow=1;" vertex="1" parent="plane2"><mxGeometry x="25" y="90" width="215" height="330" as="geometry"/></mxCell>
        <mxCell id="l7" value="&lt;b&gt;7. Claims and&lt;br&gt;Knowledge Settlement&lt;/b&gt;&lt;hr&gt;&lt;b&gt;Input&lt;/b&gt;&lt;br&gt;Observation + evidence + identity snapshot&lt;br&gt;&lt;br&gt;&lt;b&gt;Process&lt;/b&gt;&lt;br&gt;Ground claims, provenance and access&lt;br&gt;&lt;br&gt;&lt;b&gt;Output&lt;/b&gt;&lt;br&gt;Knowledge snapshot + episode event" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=11;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;shadow=1;" vertex="1" parent="plane2"><mxGeometry x="260" y="90" width="215" height="330" as="geometry"/></mxCell>
        <mxCell id="p2io" value="&lt;b&gt;PLANE INPUT&lt;/b&gt; — Evidence-grounded observations&lt;br&gt;&lt;b&gt;PLANE OUTPUT&lt;/b&gt; — Identity + exact claims + provenance + access" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#e8f5e7;strokeColor=#82b366;fontSize=14;" vertex="1" parent="plane2"><mxGeometry x="25" y="470" width="450" height="75" as="geometry"/></mxCell>

        <mxCell id="plane3" value="&lt;b&gt;PLANE 3 — SITUATION&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Which observations describe the same bounded situation?&lt;/font&gt;" style="swimlane;html=1;rounded=1;startSize=62;horizontal=1;fillColor=#ffe6cc;swimlaneFillColor=#fffaf5;strokeColor=#d79b00;fontSize=18;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1930" y="100" width="500" height="620" as="geometry"/>
        </mxCell>
        <mxCell id="l8" value="&lt;b&gt;8. Topic Routing and&lt;br&gt;Episode Membership&lt;/b&gt;&lt;hr&gt;&lt;b&gt;Input&lt;/b&gt;&lt;br&gt;Observation + identity + knowledge + claims&lt;br&gt;&lt;br&gt;&lt;b&gt;Process&lt;/b&gt;&lt;br&gt;Build signal, select anchor, compare/create topic&lt;br&gt;&lt;br&gt;&lt;b&gt;Output&lt;/b&gt;&lt;br&gt;Topic + episode + membership assertions" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=11;fillColor=#ffffff;strokeColor=#d79b00;fontSize=13;shadow=1;" vertex="1" parent="plane3"><mxGeometry x="25" y="90" width="215" height="330" as="geometry"/></mxCell>
        <mxCell id="l9" value="&lt;b&gt;9. Episode Lifecycle and&lt;br&gt;Snapshot Settlement&lt;/b&gt;&lt;hr&gt;&lt;b&gt;Input&lt;/b&gt;&lt;br&gt;Included memberships + exact evidence&lt;br&gt;&lt;br&gt;&lt;b&gt;Process&lt;/b&gt;&lt;br&gt;Manage lifecycle, contradictions, access and versions&lt;br&gt;&lt;br&gt;&lt;b&gt;Output&lt;/b&gt;&lt;br&gt;Immutable settled episode snapshot" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=11;fillColor=#ffffff;strokeColor=#d79b00;fontSize=13;shadow=1;" vertex="1" parent="plane3"><mxGeometry x="260" y="90" width="215" height="330" as="geometry"/></mxCell>
        <mxCell id="p3io" value="&lt;b&gt;PLANE INPUT&lt;/b&gt; — Identity- and knowledge-grounded observations&lt;br&gt;&lt;b&gt;PLANE OUTPUT&lt;/b&gt; — Bounded immutable episode snapshot" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#fff1df;strokeColor=#d79b00;fontSize=14;" vertex="1" parent="plane3"><mxGeometry x="25" y="470" width="450" height="75" as="geometry"/></mxCell>

        <mxCell id="boundary" value="&lt;b&gt;INGESTION BOUNDARY&lt;/b&gt;&lt;br&gt;&lt;br&gt;Settled episode&lt;br&gt;snapshot&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Reasoning starts after this point&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="2460" y="300" width="165" height="160" as="geometry"/>
        </mxCell>

        <mxCell id="e0" value="provider events" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4b5563;fontSize=11;" edge="1" parent="1" source="external" target="l1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1" value="definition" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6c8ebf;fontSize=11;" edge="1" parent="1" source="l1" target="l2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="installation" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6c8ebf;fontSize=11;" edge="1" parent="1" source="l2" target="l3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="revision" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6c8ebf;fontSize=11;" edge="1" parent="1" source="l3" target="l4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="raw object" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6c8ebf;fontSize=11;" edge="1" parent="1" source="l4" target="l5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="observation" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4b5563;fontSize=11;" edge="1" parent="1" source="l5" target="l6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="identity snapshot" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#82b366;fontSize=11;" edge="1" parent="1" source="l6" target="l7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="knowledge snapshot" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4b5563;fontSize=11;" edge="1" parent="1" source="l7" target="l8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="memberships" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#d79b00;fontSize=11;" edge="1" parent="1" source="l8" target="l9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="snapshot" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#9673a6;fontSize=11;" edge="1" parent="1" source="l9" target="boundary"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="sequence" value="&lt;b&gt;SEQUENCE&lt;/b&gt;: External source → provider revision → raw evidence → observation → identity snapshot → knowledge snapshot → topic membership → settled episode snapshot" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#4b5563;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="330" y="760" width="1960" height="65" as="geometry"/>
        </mxCell>
      </root>
