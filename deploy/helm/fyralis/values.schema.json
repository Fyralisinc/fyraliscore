{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Fyralis local BYOC chart values",
  "type": "object",
  "properties": {
    "minio": {
      "type": "object",
      "properties": {
        "bucket": {
          "type": "string",
          "minLength": 1,
          "description": "Short-retention raw-ingestion bucket."
        },
        "blobBucket": {
          "type": "string",
          "minLength": 1,
          "description": "Durable observation-artifact bucket."
        }
      },
      "required": [
        "bucket",
        "blobBucket"
      ]
    },
    "app": {
      "type": "object",
      "properties": {
        "extraEnv": {
          "type": "object",
          "description": "Non-secret runtime settings rendered to the app ConfigMap.",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "allOf": [
            {
              "not": {
                "required": [
                  "FIGMA_CLIENT_SECRET"
                ]
              }
            },
            {
              "not": {
                "required": [
                  "OAUTH_STATE_HMAC_KEY"
                ]
              }
            },
            {
              "not": {
                "required": [
                  "FIGMA_CLIENT_SECRET_SECRET_REF"
                ]
              }
            },
            {
              "not": {
                "required": [
                  "OAUTH_STATE_HMAC_KEY_SECRET_REF"
                ]
              }
            }
          ]
        },
        "figmaOAuth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "clientId": {
              "type": "string"
            },
            "redirectUri": {
              "type": "string"
            },
            "uiBaseUrl": {
              "type": "string"
            },
            "allowHttpLoopback": {
              "type": "boolean"
            },
            "scopes": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string",
              "description": "Pre-created Kubernetes Secret containing managed secret references only."
            }
          },
          "required": [
            "enabled",
            "clientId",
            "redirectUri",
            "uiBaseUrl",
            "allowHttpLoopback",
            "scopes",
            "existingSecret"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                },
                "required": [
                  "enabled"
                ]
              },
              "then": {
                "properties": {
                  "clientId": {
                    "minLength": 1
                  },
                  "redirectUri": {
                    "minLength": 1
                  },
                  "uiBaseUrl": {
                    "minLength": 1
                  },
                  "scopes": {
                    "minLength": 1
                  },
                  "existingSecret": {
                    "minLength": 1
                  }
                }
              }
            }
          ]
        }
      },
      "required": [
        "figmaOAuth"
      ]
    },
    "signalGateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "signalCliVersion": {
          "type": "string",
          "const": "0.14.4.1"
        },
        "installations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 63,
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
              },
              "tenantId": {
                "type": "string",
                "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
              },
              "installationId": {
                "type": "string",
                "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
              },
              "jsonrpcEndpoint": {
                "type": "string",
                "pattern": "^https?://.+"
              },
              "sseEndpoint": {
                "type": "string"
              },
              "multiAccount": {
                "type": "boolean"
              }
            },
            "required": [
              "name",
              "tenantId",
              "installationId",
              "jsonrpcEndpoint"
            ]
          }
        }
      },
      "required": [
        "enabled",
        "signalCliVersion",
        "installations"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "properties": {
              "installations": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "telegramGateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "installations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 63,
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
              },
              "tenantId": {
                "type": "string",
                "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
              },
              "installationId": {
                "type": "string",
                "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
              }
            },
            "required": [
              "name",
              "tenantId",
              "installationId"
            ]
          }
        }
      },
      "required": [
        "enabled",
        "installations"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "properties": {
              "installations": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
