{
  "apiVersion": "sources.fyralis.io/v1",
  "kind": "SourceConnector",
  "metadata": {
    "id": "fyralis/jira",
    "source": "jira",
    "displayName": "Jira",
    "version": "1.0.0",
    "owner": "ingestion"
  },
  "spec": {
    "contract": ">=1.0,<2.0",
    "implementation": "services.ingest.connectors.rest_sources:build_jira_connector",
    "artifactModules": [
      "services.ingest.connectors.fleet",
      "services.ingest.connectors.provider_spec",
      "services.ingest.connectors.rest_sources"
    ],
    "maturity": "stable",
    "capabilities": [
      {
        "id": "installation.configure",
        "version": 1,
        "required": true
      },
      {
        "id": "installation.secret_rotation",
        "version": 1,
        "required": true
      },
      {
        "id": "health.probe",
        "version": 1,
        "required": true,
        "configuredBy": [
          "oauth_access_token",
          "webhook_signing_secret"
        ]
      },
      {
        "id": "lifecycle.cleanup",
        "version": 1,
        "required": true
      },
      {
        "id": "ingestion.historical_pull",
        "version": 1,
        "required": true,
        "configuredBy": [
          "oauth_access_token"
        ]
      },
      {
        "id": "ingestion.reconciliation",
        "version": 1,
        "required": true
      },
      {
        "id": "ingestion.incremental_poll",
        "version": 1,
        "required": true,
        "configuredBy": [
          "oauth_access_token"
        ]
      },
      {
        "id": "ingestion.webhook",
        "version": 1,
        "required": true,
        "configuredBy": [
          "webhook_signing_secret"
        ]
      },
      {
        "id": "semantic.identity",
        "version": 1,
        "required": true
      },
      {
        "id": "semantic.normalization",
        "version": 1,
        "required": true
      }
    ],
    "ingressKinds": [
      "backfill",
      "poll",
      "webhook"
    ],
    "permissions": {
      "secretSlots": [
        "oauth_access_token",
        "webhook_signing_secret"
      ],
      "outboundHosts": [
        "api.atlassian.com"
      ],
      "requestedScopes": []
    },
    "trust": {
      "maximumTier": "authoritative"
    },
    "runtime": {
      "isolation": "in_process_trusted",
      "resourceClass": "io_standard"
    }
  }
}
