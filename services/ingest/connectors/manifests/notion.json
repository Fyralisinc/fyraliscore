{
  "apiVersion": "sources.fyralis.io/v1",
  "kind": "SourceConnector",
  "metadata": {
    "id": "fyralis/notion",
    "source": "notion",
    "displayName": "Notion",
    "version": "1.0.0",
    "owner": "ingestion"
  },
  "spec": {
    "contract": ">=1.0,<2.0",
    "implementation": "services.ingest.connectors.native:build_notion_connector",
    "artifactModules": [
      "services.ingest.connectors.notion",
      "services.ingest.connectors.oauth"
    ],
    "maturity": "stable",
    "capabilities": [
      {
        "id": "installation.configure",
        "version": 1,
        "required": true
      },
      {
        "id": "installation.secret_rotation",
        "version": 1,
        "required": true
      },
      {
        "id": "installation.oauth2",
        "version": 1,
        "required": true
      },
      {
        "id": "installation.oauth2_lifecycle",
        "version": 1,
        "required": true
      },
      {
        "id": "health.probe",
        "version": 1,
        "required": true,
        "configuredBy": [
          "oauth_access_token"
        ]
      },
      {
        "id": "lifecycle.cleanup",
        "version": 1,
        "required": true,
        "configuredBy": [
          "oauth_access_token"
        ]
      },
      {
        "id": "ingestion.historical_pull",
        "version": 1,
        "required": true,
        "configuredBy": [
          "oauth_access_token"
        ]
      },
      {
        "id": "ingestion.incremental_poll",
        "version": 1,
        "required": true,
        "configuredBy": [
          "oauth_access_token"
        ]
      },
      {
        "id": "ingestion.webhook",
        "version": 1,
        "required": true,
        "configuredBy": [
          "oauth_access_token",
          "webhook_verification_token"
        ]
      },
      {
        "id": "ingestion.reconciliation",
        "version": 1,
        "required": true,
        "configuredBy": [
          "oauth_access_token"
        ]
      },
      {
        "id": "semantic.identity",
        "version": 1,
        "required": true
      },
      {
        "id": "semantic.normalization",
        "version": 1,
        "required": true
      }
    ],
    "ingressKinds": [
      "backfill",
      "poll",
      "webhook"
    ],
    "permissions": {
      "secretSlots": [
        "oauth_access_token",
        "webhook_verification_token"
      ],
      "outboundHosts": [
        "api.notion.com"
      ],
      "requestedScopes": []
    },
    "trust": {
      "maximumTier": "attested_agent"
    },
    "runtime": {
      "isolation": "in_process_trusted"
    }
  }
}
