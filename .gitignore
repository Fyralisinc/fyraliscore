# ---- Secrets / env ----
# Never commit any .env variant. Only the *.example templates (which
# hold placeholders, no real secrets) are tracked.
.env
.env.*
!.env.example
!.env.production.example
!.env.sandbox.example
.secrets/

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
dist/
build/
*.egg-info/
.venv/
venv/
env/

# ---- Editor / OS ----
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# ---- Node / UI ----
node_modules/
ui/dist/
ui/.vite/
ui/test-results/
ui/playwright-report/
ui/coverage/

# ---- Local data / artifacts ----
*.local
Memory.md
docker-compose.override.yml
*.log
/tmp/
.scheduled_tasks.lock
.claude/scheduled_tasks.lock
# Ephemeral agent worktrees — must never be tracked (they are local checkouts)
.claude/worktrees/

# ---- Simulation run artifacts ----
test-results/
/reports/company-learning-assurance-*

# ---- External tools / large local dirs ----
lsob/
corpora/

# ---- Production secrets (server-only) ----
.env.production

# ---- Credentials / keys (defensive) ----
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
id_rsa*
id_ed25519*

# ---- Local databases / dumps ----
*.sqlite
*.sqlite3
*.db
*.dump

# Local DB dump directory (pg_dump snapshots, restore scripts — not source)
backups/

# Local skills cache + lockfile (per-machine tooling, not source)
.agents/
skills-lock.json

# Scratch refactor transcript (internal dev note, kept local)
think_refactor.md


# Synthesis harness per-run calibration artifacts (the baseline + README are tracked)
tests/synthesis_harness/runs/

# Per-run "last run" snapshots — outputs, not source (were tracked by mistake;
# the auto-commit Stop-hook kept re-snapshotting them).
tests/synthesis_harness/_last_run.json
tests/retrieval_e2e/_last_run.json

# Real-LLM local run artifacts
tests/real_llm/cache/
tests/real_llm/reports/runs/

# Benchmark and local probe outputs
benchmarks/.cache/
benchmarks/datasets/raw/
benchmarks/datasets/tmp/
benchmarks/reports/generated/
benchmarks/reports/think-*/
truss_run/
truss_run_*/
.codex-run-logs/

