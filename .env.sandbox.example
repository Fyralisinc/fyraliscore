# =====================================================================
# .env.sandbox.example — local "real-API" sandbox OVERRIDE layer
# =====================================================================
# Copy to `.env.sandbox` (gitignored) and fill in. This file is loaded
# by docker-compose.sandbox.yml LAST, AFTER `.env`, so it only needs to
# contain values that DIFFER from your existing `.env`:
#
#     env_file: [.env, .env.sandbox]   # last wins
#
# That means your real Slack/Discord creds, MASTER_KEK, OAUTH_STATE_HMAC_KEY
# and AUTH_BOOTSTRAP_SECRET already in `.env` are reused as-is — you do
# NOT need to repeat them here unless you want to override them.
#
# What this sandbox is: the full ingestion data plane runs locally (your
# machine, docker-compose), but GitHub / Slack / Discord are the REAL
# provider APIs. An ngrok tunnel gives the local gateway a public HTTPS
# URL so real webhooks + OAuth callbacks can reach it. Gmail is skipped.
#
# NOTE: compose env_file is literal KEY=VALUE — there is NO ${VAR}
# expansion here. Write full URLs out; do not reference other vars.
# ---------------------------------------------------------------------

# ---- Prod-guard profile (highest fidelity; the research plan's choice)
# These override .env's dev values. The base compose ALSO pins these via
# `environment:`, but we set them here too so the value is unambiguous.
COMPANY_OS_ENV=prod
FYRALIS_ENV=prod
GATEWAY_MOUNT_SIM=0
# Webhook signing secrets resolve ONLY from the encrypted DB store in
# prod (provider_installations.secret_ref). The env-var fallback is
# refused at gateway startup when this is 1 in prod — keep it 0.
WEBHOOK_SECRETS_ENV_FALLBACK_ALLOW=0
# Webhooks resolve tenant from the installation row, never a default.
WEBHOOK_TENANT_DEFAULT_ALLOW=0
# Stable channel-sampling seed for Discord backfill across restarts.
PYTHONHASHSEED=0

# ---- Sandbox tenant (seeded by scripts/seed_dogfood_tenant.py) -------
# Reuses the default dev tenant/actor UUIDs so the seed + session +
# install flow line up. Inherited from .env if already set there.
COMPANY_OS_TENANT_ID=00000000-0000-0000-0000-000000000001
COMPANY_OS_CEO_ACTOR_ID=00000000-0000-0000-0000-000000000002

# ---- Public ingress (ngrok) ------------------------------------------
# Your ngrok URL for this run. With a reserved/static ngrok domain this
# is stable; with a free ephemeral tunnel it changes each `ngrok` start
# (then you must update this AND the three provider apps' URLs).
#   Free ephemeral example: https://abc123.ngrok-free.app
#   Reserved domain example: https://fyralis-sandbox.ngrok.app
SANDBOX_PUBLIC_URL=https://YOUR-NGROK-SUBDOMAIN.ngrok-free.app

# OAuth redirect URIs the gateway sends to Slack/Discord — these MUST
# match what is registered in each provider app. Write the SAME host as
# SANDBOX_PUBLIC_URL above (no ${} expansion in env files).
SLACK_REDIRECT_URI=https://YOUR-NGROK-SUBDOMAIN.ngrok-free.app/integrations/slack/callback
DISCORD_REDIRECT_URI=https://YOUR-NGROK-SUBDOMAIN.ngrok-free.app/integrations/discord/callback

# ---------------------------------------------------------------------
# Slack  — REUSED FROM .env if already set there. Set here only to
# override. The signing secret is what gets stored encrypted on install.
# ---------------------------------------------------------------------
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=          # stored encrypted by the OAuth callback
# WEBHOOK_SECRET_SLACK=          # legacy/dev only — unused under prod guards
# SLACK_MAX_TIMESTAMP_AGE_S=300
# SLACK_BACKFILL_INCLUDE_PRIVATE=0

# ---------------------------------------------------------------------
# Discord — REUSED FROM .env if already set there.
# WEBHOOK_SECRET_DISCORD is the app's Ed25519 PUBLIC KEY; the OAuth
# callback mirrors it into the encrypted store as the verification key.
# ---------------------------------------------------------------------
# DISCORD_BOT_TOKEN=
# DISCORD_APPLICATION_ID=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# WEBHOOK_SECRET_DISCORD=        # Ed25519 public key (hex)
# DISCORD_MAX_TIMESTAMP_AGE_S=300

# ---------------------------------------------------------------------
# GitHub App — NOT in .env; fill these in. The OAuth callback writes the
# installation row with secret_ref=NULL, so the webhook signing secret
# must be seeded into the encrypted store after install:
#   python scripts/sandbox_seed_secret.py github <installation_id> "<WEBHOOK_SECRET_GITHUB value>"
# ---------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Provide exactly ONE: inline PEM contents, or a mounted file path.
GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github_app.pem
# The webhook secret you set on the GitHub App. Kept here for reference /
# for the seed script; verification reads it from the encrypted store.
WEBHOOK_SECRET_GITHUB=
# Raise only to bound a >90-repo install deliberately (0 = no cap).
# GITHUB_MAX_BACKFILL_REPOS=0

# ---------------------------------------------------------------------
# Crypto keys — INHERITED FROM .env. Only set here to override. If you
# do NOT have them in .env, generate ONCE and store durably (regenerating
# MASTER_KEK orphans every encrypted secret in the DB):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ---------------------------------------------------------------------
# MASTER_KEK=
# OAUTH_STATE_HMAC_KEY=
# AUTH_BOOTSTRAP_SECRET=

# ---- Gmail: intentionally left UNSET so the gateway does NOT mount the
# Gmail routers and the gmail_* workers stay disabled in the sandbox. ---

LOG_LEVEL=INFO
