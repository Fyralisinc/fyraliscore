# =====================================================================
# .env.sandbox.example — local "real-API" sandbox OVERRIDE layer
# =====================================================================
# Copy to `.env.sandbox` (gitignored) and fill in. This file is loaded
# by docker-compose.sandbox.yml LAST, AFTER `.env`, so it only needs to
# contain values that DIFFER from your existing `.env`:
#
#     env_file: [.env, .env.sandbox]   # last wins
#
# That means your real Slack/Discord creds, MASTER_KEK, OAUTH_STATE_HMAC_KEY
# and AUTH_BOOTSTRAP_SECRET already in `.env` are reused as-is — you do
# NOT need to repeat them here unless you want to override them.
#
# What this sandbox is: the full ingestion data plane runs locally (your
# machine, docker-compose), but GitHub / Slack / Discord are the REAL
# provider APIs. An ngrok tunnel gives the local gateway a public HTTPS
# URL so real webhooks + OAuth callbacks can reach it. Gmail is skipped.
#
# NOTE: compose env_file is literal KEY=VALUE — there is NO ${VAR}
# expansion here. Write full URLs out; do not reference other vars.
# ---------------------------------------------------------------------

# ---- Prod-guard profile (highest fidelity; the research plan's choice)
# These override .env's dev values. The base compose ALSO pins these via
# `environment:`, but we set them here too so the value is unambiguous.
COMPANY_OS_ENV=prod
FYRALIS_ENV=prod
# Webhook signing secrets resolve ONLY from the encrypted DB store in
# prod (provider_installations.secret_ref). The env-var fallback is
# refused at gateway startup when this is 1 in prod — keep it 0.
WEBHOOK_SECRETS_ENV_FALLBACK_ALLOW=0
# Webhooks resolve tenant from the installation row, never a default.
WEBHOOK_TENANT_DEFAULT_ALLOW=0
# Keep hashing deterministic in sandbox diagnostics.
PYTHONHASHSEED=0
# Local setup-owner automation endpoint gate. The sandbox compose overlay
# runs the gateway as dev, so this exposes /platform/onboarding/sources/* only
# for local rehearsal and never for production.
FYRALIS_SOURCE_REHEARSAL_ENABLED=1
FYRALIS_SOURCE_AUTO_CONNECT_EXECUTE_BROWSER_DOM=1
FYRALIS_SOURCE_AUTO_CONNECT_HEADLESS_BROWSER=1

# ---- Ingestion throughput tuning ------------------------------------
# Sandbox defaults are intentionally lower than production so one laptop
# can exercise the concurrent code paths without starving Postgres/Ollama.
NORMALIZER_MAX_CONCURRENCY=8
WRITER_BATCH_SIZE=50
WRITER_BATCH_TIMEOUT_MS=250
WRITER_MAX_CONCURRENCY=4
WRITER_POSTGRES_POOL_SIZE=12
EMBEDDING_MAX_CONCURRENCY=2
POSTGRES_POOL_SIZE=5
KAFKA_FLUSH_BATCH_MAX_DELAY_MS=10
GMAIL_HISTORY_POLLER_MAX_CONCURRENCY=4
GOOGLE_CALENDAR_LIVE_POLLER_MAX_CONCURRENCY=4
GOOGLE_DRIVE_LIVE_POLLER_MAX_CONCURRENCY=4
SHARD_FETCH_BATCH=auto
SHARD_FETCH_CONCURRENCY=auto
DISCORD_GATEWAY_INSTALLATION_CACHE_TTL_SECONDS=5
SHARD_FETCH_S3_WRITE_CONCURRENCY=16

# ---- Sandbox tenant (seeded by scripts/seed_dogfood_tenant.py) -------
# Reuses the default dev tenant/actor UUIDs so the seed + session +
# install flow line up. Inherited from .env if already set there.
COMPANY_OS_TENANT_ID=00000000-0000-0000-0000-000000000001
COMPANY_OS_CEO_ACTOR_ID=00000000-0000-0000-0000-000000000002

# ---- Public ingress (ngrok) ------------------------------------------
# Your ngrok URL for this run. With a reserved/static ngrok domain this
# is stable; with a free ephemeral tunnel it changes each `ngrok` start
# (then you must update this AND the three provider apps' URLs).
#   Free ephemeral example: https://abc123.ngrok-free.app
#   Reserved domain example: https://fyralis-sandbox.ngrok.app
SANDBOX_PUBLIC_URL=https://YOUR-NGROK-SUBDOMAIN.ngrok-free.app

# OAuth redirect URIs the gateway sends to Slack/Discord — these MUST
# match what is registered in each provider app. Write the SAME host as
# SANDBOX_PUBLIC_URL above (no ${} expansion in env files).
SLACK_REDIRECT_URI=https://YOUR-NGROK-SUBDOMAIN.ngrok-free.app/integrations/slack/callback
DISCORD_REDIRECT_URI=https://YOUR-NGROK-SUBDOMAIN.ngrok-free.app/integrations/discord/callback
NOTION_REDIRECT_URI=https://YOUR-NGROK-SUBDOMAIN.ngrok-free.app/integrations/notion/callback

# ---------------------------------------------------------------------
# Slack  — REUSED FROM .env if already set there. Set here only to
# override. The signing secret is what gets stored encrypted on install.
# ---------------------------------------------------------------------
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=          # stored encrypted by the OAuth callback
# WEBHOOK_SECRET_SLACK=          # legacy/dev only — unused under prod guards
# SLACK_MAX_TIMESTAMP_AGE_S=300
# SLACK_BACKFILL_INCLUDE_PRIVATE=0

# ---------------------------------------------------------------------
# Discord — REUSED FROM .env if already set there.
# WEBHOOK_SECRET_DISCORD is the app's Ed25519 PUBLIC KEY; the OAuth
# callback mirrors it into the encrypted store as the verification key.
# ---------------------------------------------------------------------
# DISCORD_BOT_TOKEN=
# DISCORD_APPLICATION_ID=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# WEBHOOK_SECRET_DISCORD=        # Ed25519 public key (hex)
# DISCORD_MAX_TIMESTAMP_AGE_S=300

# ---------------------------------------------------------------------
# GitHub App — NOT in .env; fill these in. The OAuth callback writes the
# installation row with secret_ref=NULL, so the webhook signing secret
# must be seeded into the encrypted store after install:
#   python scripts/sandbox_seed_secret.py github <installation_id> "<WEBHOOK_SECRET_GITHUB value>"
# ---------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Provide exactly ONE: inline PEM contents, or a mounted file path.
GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github_app.pem
# The webhook secret you set on the GitHub App. Kept here for reference /
# for the seed script; verification reads it from the encrypted store.
WEBHOOK_SECRET_GITHUB=
# Raise only to bound a >90-repo install deliberately (0 = no cap).
# GITHUB_MAX_BACKFILL_REPOS=0

# ---------------------------------------------------------------------
# Notion (IN-14) — NOT in .env; fill these in to enable Notion ingest.
# The OAuth callback stores the long-lived per-workspace bot token in the
# encrypted store as the install's secret_ref. Backfill + the 15-min poll
# run on the same workers as the other sources and are the CORRECTNESS
# BACKSTOP — they cover the full object tree (pages, blocks, comments,
# database rows).
#
# Create a PUBLIC OAuth integration at https://www.notion.so/my-integrations
# (set the redirect URI to NOTION_REDIRECT_URI above). Then, IMPORTANT:
# share the databases/pages you want ingested with the integration
# (page ••• → Connections → add it) — Notion only exposes shared objects.
# ---------------------------------------------------------------------
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Optional tuning (defaults shown):
# NOTION_POLL_INTERVAL_SECONDS=900    # incremental re-scan cadence (15 min)
# NOTION_BLOCK_DEPTH_CAP=3            # page-body block recursion depth cap
# NOTION_API_VERSION=2022-06-28       # pinned Notion-Version header
#
# ---- Notion webhook (OPTIONAL, IN-14) --------------------------------
# Notion webhooks deliver low-latency PAGE updates between poll cycles
# (the page-only fast path; backfill/poll still covers everything else).
# Unlike OAuth bot tokens, the webhook signing token is APP-LEVEL — ONE
# value for the whole integration across every workspace — so it lives in
# env, not the per-install secret_ref (mirrors WEBHOOK_SECRET_GITHUB).
#
# Setup: in your integration's settings add a webhook subscription pointed
# at  <SANDBOX_PUBLIC_URL>/webhooks/notion/events . Notion then POSTs a
# one-time UNSIGNED verification request carrying a `verification_token`.
# The gateway logs it at WARNING (grep the gateway logs for
# `notion_webhook_verification_token_received`); copy that value here and
# restart the gateway so subsequent signed events verify. Leave UNSET to
# run Notion in backfill+poll-only mode (the webhook endpoint then rejects
# events with secret_not_configured, which is harmless).
# NOTION_WEBHOOK_VERIFICATION_TOKEN=
# NOTION_WEBHOOK_VERIFICATION_TOKEN_PREV=   # set during token rotation only

# ---- Jira (IN-17) ----------------------------------------------------
# Jira Cloud authenticates with HTTP Basic (account email + API token) against
# your per-site base URL. Backfill (JQL search) + live webhooks both route
# through the full pipeline. See docs/ingestion/jira-sandbox.md.
#
# 1) Credentials you supply (the operator handoff step):
#      JIRA_BASE_URL=https://<your-site>.atlassian.net
#      JIRA_ACCOUNT_EMAIL=<your-atlassian-account-email>
#      JIRA_API_TOKEN=<token from id.atlassian.com/manage-profile/security/api-tokens>
#    The seed script (scripts/sandbox_jira_seed.py) stores the API token in the
#    encrypted secret store and writes the jira_installations + jira_projects
#    rows + the onboarding trigger that fires the backfill chain.
# JIRA_BASE_URL=
# JIRA_ACCOUNT_EMAIL=
# JIRA_API_TOKEN=
#
# 2) Live webhooks (OPTIONAL): in Jira → Settings → System → Webhooks, create a
#    webhook pointed at  <SANDBOX_PUBLIC_URL>/webhooks/jira/events  with a
#    Secret; Jira signs each delivery with HMAC-SHA256 in the X-Hub-Signature
#    header (GitHub-style). Put the SAME secret here; the seed script copies it
#    into the provider_installations row so the edge verifies + resolves tenant.
#    Subscribe to issue created/updated + comment created/updated events.
#    Leave UNSET to run Jira in backfill-only mode.
# JIRA_WEBHOOK_SECRET=
#
# JIRA_BACKFILL_PAGE_SIZE=100          # JQL search page size (max 100)

# ---------------------------------------------------------------------
# Periodic reconcile cadence — RELAXED for the sandbox.
# The PeriodicReconciler re-checks each (tenant, source) for gaps the
# live path may have missed. Notion webhook coverage is PAGE-ONLY, so a
# tight reconcile cadence is the backstop that pulls in blocks, comments,
# database rows, and any dropped webhook. Prod defaults (tick 300s,
# min-age 6h) are too slow to observe in a sandbox session, so shorten
# them here. Raise toward the defaults to mimic prod load.
# ---------------------------------------------------------------------
PERIODIC_RECONCILE_TICK_SEC=60
PERIODIC_RECONCILE_MIN_AGE_SEC=300

# ---------------------------------------------------------------------
# Crypto keys — INHERITED FROM .env. Only set here to override. If you
# do NOT have them in .env, generate ONCE and store durably (regenerating
# MASTER_KEK orphans every encrypted secret in the DB):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ---------------------------------------------------------------------
# MASTER_KEK=
# OAUTH_STATE_HMAC_KEY=
# AUTH_BOOTSTRAP_SECRET=

# ---- Gmail: intentionally left UNSET so the gateway does NOT mount the
# Gmail routers and the gmail_* workers stay disabled in the sandbox. ---

LOG_LEVEL=INFO
