{
  "__inputs": [
    {
      "name": "DS_CP",
      "label": "CP Prometheus",
      "description": "The dedicated control-plane self-obs Prometheus (cp-prometheus.yml). Provision as a Grafana datasource (suggested uid: fyralis-cp-prometheus) at Assemble time.",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.1.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Control-plane self-observability (WS-SELFOBS / NFR-10). Reads the DEDICATED cp self-obs Prometheus (cp-prometheus.yml), which actively probes every CP service via cp_exporter.py. 'silence != health': the top-left silence panel turns red if the exporter heartbeat goes stale or absent, so a green board with no data is impossible to mistake for healthy.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "panels": [],
      "title": "Control-plane health (silence != health)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_CP}" },
      "description": "SILENCE WATCHDOG (NFR-10). Age of the exporter's self-scrape heartbeat. Green only while fresh; RED if stale (>90s) and 'No data' renders RED via the override — an empty board cannot look healthy.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "noValue": "SILENT",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 30 },
              { "color": "red", "value": 90 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 5, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "11.1.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_CP}" },
          "editorMode": "code",
          "expr": "cp:self_scrape_heartbeat_age_seconds",
          "legendFormat": "heartbeat age",
          "refId": "A"
        }
      ],
      "title": "Self-obs heartbeat age",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_CP}" },
      "description": "Fraction of configured CP services whose last probe was healthy. 1 = all green.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.75 },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 5, "x": 5, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "11.1.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_CP}" },
          "editorMode": "code",
          "expr": "cp:services_healthy_ratio",
          "legendFormat": "healthy ratio",
          "refId": "A"
        }
      ],
      "title": "CP services healthy",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_CP}" },
      "description": "Ingest-path-alive synthetic: can a tenant agent push through the auth-proxy into Mimir right now? 1 = usable. The 'mode' label tells you whether it was proven by a real push (fullpush) or inferred structurally (structural).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "color": "red", "index": 1, "text": "DOWN" } }, "type": "value" },
            { "options": { "1": { "color": "green", "index": 0, "text": "ALIVE" } }, "type": "value" }
          ],
          "noValue": "NO DATA",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 5, "x": 10, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "11.1.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_CP}" },
          "editorMode": "code",
          "expr": "max by (mode) (cp_ingest_path_alive)",
          "legendFormat": "{{mode}}",
          "refId": "A"
        }
      ],
      "title": "Ingest path alive",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_CP}" },
      "description": "Count of CP services up (out of total). A second-opinion rollup next to the per-service table below.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 15, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "pluginVersion": "11.1.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_CP}" },
          "editorMode": "code",
          "expr": "cp_services_up",
          "legendFormat": "up",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_CP}" },
          "editorMode": "code",
          "expr": "cp_services_total",
          "legendFormat": "total",
          "refId": "B"
        }
      ],
      "title": "Services up / total",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_CP}" },
      "description": "Age since the ingest path was last observed alive. RED past 5m mirrors the IngestPathStale alert.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "noValue": "NEVER",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 120 },
              { "color": "red", "value": 300 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 5, "x": 19, "y": 1 },
      "id": 5,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "11.1.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_CP}" },
          "editorMode": "code",
          "expr": "cp:ingest_path_last_success_age_seconds",
          "legendFormat": "ingest last-success age",
          "refId": "A"
        }
      ],
      "title": "Ingest last-success age",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "id": 101,
      "panels": [],
      "title": "Per-service detail",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_CP}" },
      "description": "Per-service probe status. up=1 healthy. component/probe show how each service is checked (auth-proxy is a TLS handshake; mimir/loki are /ready; the rest are HTTP /healthz).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
          "mappings": [
            { "options": { "0": { "color": "red", "index": 1, "text": "DOWN" } }, "type": "value" },
            { "options": { "1": { "color": "green", "index": 0, "text": "UP" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "text", "value": null } ] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Value #UP" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              { "id": "displayName", "value": "status" }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "id": 6,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true
      },
      "pluginVersion": "11.1.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_CP}" },
          "editorMode": "code",
          "expr": "cp_service_up",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "UP"
        }
      ],
      "title": "Service probe status",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "instance": true, "job": true, "plane": true, "role": true, "monitor": true },
            "renameByName": {}
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_CP}" },
      "description": "Per-service probe up/down over time.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 15,
            "gradientMode": "none",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" }
          },
          "mappings": [],
          "max": 1,
          "min": 0,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "id": 7,
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "pluginVersion": "11.1.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_CP}" },
          "editorMode": "code",
          "expr": "cp_service_up",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "title": "Service up over time",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_CP}" },
      "description": "Per-service health-probe latency (the cp_exporter probe duration). Watch for creep before it becomes a timeout.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "seconds",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" }
          },
          "mappings": [],
          "min": 0,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 2 } ] },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "id": 8,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "pluginVersion": "11.1.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_CP}" },
          "editorMode": "code",
          "expr": "cp_probe_latency_seconds",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "title": "Probe latency by service",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_CP}" },
      "description": "Ingest-path-alive synthetic over time (1 alive / 0 down), and the self-obs heartbeat age (silence). If the heartbeat-age line climbs, the whole board is going dark.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 15,
            "gradientMode": "none",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "self-obs heartbeat age (s)" },
            "properties": [ { "id": "unit", "value": "s" }, { "id": "custom.axisPlacement", "value": "right" } ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "id": 9,
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "pluginVersion": "11.1.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_CP}" },
          "editorMode": "code",
          "expr": "max(cp_ingest_path_alive)",
          "legendFormat": "ingest path alive",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_CP}" },
          "editorMode": "code",
          "expr": "cp:self_scrape_heartbeat_age_seconds",
          "legendFormat": "self-obs heartbeat age (s)",
          "refId": "B"
        }
      ],
      "title": "Ingest path + silence over time",
      "type": "timeseries"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["control-plane", "self-obs", "nfr-10"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "CP Prometheus",
        "multi": false,
        "name": "DS_CP",
        "options": [],
        "query": "prometheus",
        "queryValue": "",
        "refresh": 1,
        "regex": "/.*[Cc][Pp].*/",
        "skipUrlSync": false,
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "utc",
  "title": "Control-Plane Self-Observability",
  "uid": "fyralis-cp-self-obs",
  "version": 1,
  "weekStart": ""
}
