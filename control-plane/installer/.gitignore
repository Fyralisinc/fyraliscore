# WS-INSTALLER — generated, never-commit artifacts
# ----------------------------------------------------------------------------
# Rendered per-deployment env (contains absolute bundle paths; regenerated by
# install.sh on every run).
.deployment.env

# Sample / real agent bundles minted by make_sample_bundle.py. These carry a
# tenant private key (client.key) + signed license/config — never commit them.
sample-bundle/
*-bundle/
bundles/

# python
__pycache__/
*.pyc
