{
  "uid": "fyralis-embeddings-ollama",
  "title": "Fyralis · Embeddings / Ollama",
  "tags": ["fyralis"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "editable": false,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Embed latency p50 / p95 / p99 (ok)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "fyralis-prom"},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(ollama_embed_request_duration_seconds_bucket{status=\"ok\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ollama_embed_request_duration_seconds_bucket{status=\"ok\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(ollama_embed_request_duration_seconds_bucket{status=\"ok\"}[5m])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "options": {}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Embed request rate by status",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "fyralis-prom"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(ollama_embed_requests_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "options": {}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Embed success ratio (10m)",
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "fyralis-prom"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ollama_embed_requests_total{status=\"ok\"}[10m])) / clamp_min(sum(rate(ollama_embed_requests_total[10m])),1e-9)",
          "legendFormat": "success ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 0.95},
              {"color": "green", "value": 0.99}
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Dimension mismatches (lifetime)",
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 8},
      "datasource": {"type": "prometheus", "uid": "fyralis-prom"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ollama_embed_dimension_mismatch_total)",
          "legendFormat": "mismatches"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Embed retries by model",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "fyralis-prom"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model) (rate(ollama_embed_retries_total[5m]))",
          "legendFormat": "{{model}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Embed failure ratio (worker level, 10m)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "datasource": {"type": "prometheus", "uid": "fyralis-prom"},
      "targets": [
        {
          "refId": "A",
          "expr": "fyralis:embed_failure_ratio:10m",
          "legendFormat": "failure ratio"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "options": {}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Embedding backlog: depth / drain / rate-limit denials",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "datasource": {"type": "prometheus", "uid": "fyralis-prom"},
      "targets": [
        {
          "refId": "A",
          "expr": "fyralis_embedding_backlog_pending",
          "legendFormat": "backlog pending"
        },
        {
          "refId": "B",
          "expr": "rate(ingestion_backlog_rows_embedded[5m])",
          "legendFormat": "drain rate (rows/s)"
        },
        {
          "refId": "C",
          "expr": "rate(ingestion_backlog_rate_limit_denials[5m])",
          "legendFormat": "rate-limit denials/s"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Embedding worker: embeds succeeded / failed",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24},
      "datasource": {"type": "prometheus", "uid": "fyralis-prom"},
      "targets": [
        {
          "refId": "A",
          "expr": "rate(ingestion_embedding_worker_embeds_succeeded[5m])",
          "legendFormat": "succeeded/s"
        },
        {
          "refId": "B",
          "expr": "rate(ingestion_embedding_worker_embeds_failed[5m])",
          "legendFormat": "failed/s"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {}
    }
  ]
}
