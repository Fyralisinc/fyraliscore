        <mxCell id="p2-in3" value="&lt;b&gt;ActorReviewCommandV1&lt;/b&gt;&lt;br&gt;task/version · action · candidate token&lt;br&gt;reviewer · rationale" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fce7f3;strokeColor=#db2777;strokeWidth=2;fontSize=13;fontColor=#0f172a;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="65" y="565" width="280" height="115" as="geometry" />
        </mxCell>
        <mxCell id="p2-inbox" value="&lt;b&gt;1 · Inbox / Idempotency&lt;/b&gt;&lt;br&gt;key = tenant + event + observation version&lt;br&gt;+ policy version + command/reason&lt;br&gt;lease · retry · replay-safe completion" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontSize=13;fontColor=#0f172a;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="235" width="280" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p2-normalize" value="&lt;b&gt;2 · SourcePrincipal Normalizer&lt;/b&gt;&lt;br&gt;(tenant, installation, source,&lt;br&gt;native_type, native_id)&lt;br&gt;&lt;font color=&quot;#166534&quot;&gt;Never store “slack:U204” as native_id&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontSize=13;fontColor=#0f172a;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="790" y="235" width="305" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p2-mentions" value="&lt;b&gt;3 · Person Mention Intake&lt;/b&gt;&lt;br&gt;connector-native references first&lt;br&gt;span-based NER + overlap suppression&lt;br&gt;evidence-bound mention IDs" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontSize=13;fontColor=#0f172a;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="630" y="465" width="305" height="155" as="geometry" />
        </mxCell>
        <mxCell id="p2-grounded" value="&lt;b&gt;Grounding result&lt;/b&gt;&lt;br&gt;GROUNDED or UNGROUNDED&lt;br&gt;SourcePrincipalRef + evidence lineage&lt;br&gt;&lt;font color=&quot;#b45309&quot;&gt;No Actor ID implied&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fef9c3;strokeColor=#ca8a04;strokeWidth=2;fontSize=13;fontColor=#0f172a;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="960" y="465" width="150" height="155" as="geometry" />
        </mxCell>
        <mxCell id="p2-providers" value="&lt;b&gt;4 · Candidate Providers&lt;/b&gt;&lt;br&gt;accepted source mapping&lt;br&gt;verified email/employee claim&lt;br&gt;directory + alias/name search&lt;br&gt;model-assisted retrieval (optional)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontSize=13;fontColor=#0f172a;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1230" y="235" width="250" height="185" as="geometry" />
        </mxCell>
        <mxCell id="p2-token" value="&lt;b&gt;5 · Candidate Token Service&lt;/b&gt;&lt;br&gt;server-issued · signed · expiring&lt;br&gt;token → actor binding&lt;br&gt;provider cannot submit arbitrary IDs" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffe4e6;strokeColor=#e11d48;strokeWidth=2;fontSize=13;fontColor=#0f172a;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1510" y="235" width="250" height="185" as="geometry" />
        </mxCell>
        <mxCell id="p2-validate" value="&lt;b&gt;6 · Deterministic Validator&lt;/b&gt;&lt;br&gt;tenant · person type · existence&lt;br&gt;event time · lifecycle · redirects&lt;br&gt;evidence ACL · must/cannot-link" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fef9c3;strokeColor=#ca8a04;strokeWidth=2;fontSize=13;fontColor=#0f172a;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1790" y="235" width="285" height="185" as="geometry" />
        </mxCell>
        <mxCell id="p2-score" value="&lt;b&gt;7 · Calibrated Scoring&lt;/b&gt;&lt;br&gt;raw features + calibration version&lt;br&gt;threshold + minimum margin&lt;br&gt;blast radius / evidence quality" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fef9c3;strokeColor=#ca8a04;strokeWidth=2;fontSize=13;fontColor=#0f172a;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1300" y="490" width="250" height="155" as="geometry" />
        </mxCell>
        <mxCell id="p2-decision" value="&lt;b&gt;8 · Conservative Decision&lt;/b&gt;&lt;br&gt;&lt;b&gt;LINKED_EXISTING&lt;/b&gt;&lt;br&gt;&lt;b&gt;REVIEW_REQUIRED&lt;/b&gt;&lt;br&gt;NO_MATCH · NOT_PERSON · UNRESOLVED" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fef9c3;strokeColor=#ca8a04;strokeWidth=2;fontSize=13;fontColor=#0f172a;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1590" y="490" width="300" height="155" as="geometry" />
        </mxCell>
        <mxCell id="p2-abstain" value="&lt;b&gt;Abstention is valid output&lt;/b&gt;&lt;br&gt;No LLM is sole authority&lt;br&gt;No forced top-1 selection&lt;br&gt;Partial snapshots continue downstream" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=2;fontSize=13;fontColor=#0f172a;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1930" y="490" width="150" height="155" as="geometry" />
        </mxCell>
        <mxCell id="p2-task" value="&lt;b&gt;Review Task&lt;/b&gt;&lt;br&gt;top candidates + reason codes&lt;br&gt;evidence-safe excerpts&lt;br&gt;expected actor type + impact" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fce7f3;strokeColor=#db2777;strokeWidth=2;fontSize=13;fontColor=#0f172a;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="2200" y="235" width="240" height="155" as="geometry" />
        </mxCell>
        <mxCell id="p2-reviewer" value="&lt;b&gt;Authorized Reviewer&lt;/b&gt;&lt;br&gt;MATCH · DISTINCT&lt;br&gt;NOT_PERSON · DEFER&lt;br&gt;optimistic task version" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fce7f3;strokeColor=#db2777;strokeWidth=2;fontSize=13;fontColor=#0f172a;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="2480" y="235" width="240" height="155" as="geometry" />
        </mxCell>
        <mxCell id="p2-command" value="&lt;b&gt;Append review decision&lt;/b&gt;&lt;br&gt;never mutate prior decision&lt;br&gt;enqueue targeted re-resolution&lt;br&gt;preserve reviewer provenance" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fce7f3;strokeColor=#db2777;strokeWidth=2;fontSize=13;fontColor=#0f172a;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="2335" y="485" width="260" height="155" as="geometry" />
        </mxCell>
        <mxCell id="p2-ledger" value="&lt;b&gt;9 · Append-only Actor Identity Ledger&lt;/b&gt;&lt;br&gt;grounding + canonicalization outcome&lt;br&gt;selected token/actor · alternatives · scores&lt;br&gt;policy/model/calibrator versions · reason codes" style="shape=cylinder3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f3e8ff;strokeColor=#9333ea;strokeWidth=2;fontSize=13;fontColor=#0f172a;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="870" width="350" height="210" as="geometry" />
        </mxCell>
        <mxCell id="p2-snapshot" value="&lt;b&gt;10 · Immutable Actor Snapshot&lt;/b&gt;&lt;br&gt;complete or partial&lt;br&gt;content-addressed snapshot hash&lt;br&gt;prior snapshot retained on correction" style="shape=cylinder3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f3e8ff;strokeColor=#9333ea;strokeWidth=2;fontSize=13;fontColor=#0f172a;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="875" y="870" width="330" height="210" as="geometry" />
        </mxCell>
        <mxCell id="p2-outbox" value="&lt;b&gt;11 · Transactional Outbox&lt;/b&gt;&lt;br&gt;same transaction as decision/snapshot&lt;br&gt;at-least-once publication&lt;br&gt;event ID + aggregate/version dedupe" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffedd5;strokeColor=#ea580c;strokeWidth=2;fontSize=13;fontColor=#0f172a;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1250" y="870" width="330" height="210" as="geometry" />
        </mxCell>
        <mxCell id="p2-projector" value="&lt;b&gt;12 · One-way Projectors&lt;/b&gt;&lt;br&gt;actor_identity_mappings&lt;br&gt;aliases + observation compatibility&lt;br&gt;fully rebuildable; never reverse-write" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#cffafe;strokeColor=#0891b2;strokeWidth=2;fontSize=13;fontColor=#0f172a;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1625" y="870" width="330" height="210" as="geometry" />
        </mxCell>
        <mxCell id="p2-invariants" value="&lt;b&gt;Non-negotiable invariants&lt;/b&gt;&lt;br&gt;• Actor domain owns actor lifecycle&lt;br&gt;• Identity owns linkage/non-linkage and lineage&lt;br&gt;• Candidate must be typed and tenant-scoped&lt;br&gt;• Every outcome is persisted&lt;br&gt;• Correction creates a new snapshot" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=2;fontSize=13;fontColor=#0f172a;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="1095" width="1475" height="115" as="geometry" />
        </mxCell>
        <mxCell id="p2-out1" value="&lt;b&gt;ActorResolutionSnapshotPublishedV1&lt;/b&gt;&lt;br&gt;snapshot ID/hash · observation/version&lt;br&gt;status: complete | partial" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#cffafe;strokeColor=#0891b2;strokeWidth=2;fontSize=13;fontColor=#0f172a;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="2205" y="835" width="510" height="105" as="geometry" />
        </mxCell>
        <mxCell id="p2-out2" value="&lt;b&gt;ActorIdentityChangedV1&lt;/b&gt;&lt;br&gt;prior/new accepted linkage&lt;br&gt;effective time + cause decision" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#cffafe;strokeColor=#0891b2;strokeWidth=2;fontSize=13;fontColor=#0f172a;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="2205" y="970" width="510" height="105" as="geometry" />
        </mxCell>
        <mxCell id="p2-out3" value="&lt;b&gt;ActorReviewRequiredV1&lt;/b&gt;&lt;br&gt;task ID/version · safe alternatives&lt;br&gt;reason codes + review SLA" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fce7f3;strokeColor=#db2777;strokeWidth=2;fontSize=13;fontColor=#0f172a;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="2205" y="1105" width="510" height="105" as="geometry" />
        </mxCell>
        <mxCell id="p2-stores" value="&lt;b&gt;Durable model&lt;/b&gt;: source_principals · person_mentions · candidate_tokens · candidates · constraints · actor_resolution_decisions · actor_links/memberships · review_tasks · actor_resolution_snapshots · inbox/outbox" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=2;fontSize=13;fontColor=#0f172a;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="1310" width="2330" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2-legend" value="&lt;b&gt;Sequence&lt;/b&gt;: event → canonical source principal → person mention → typed actor candidates → validation → conservative decision → append-only ledger → immutable snapshot → versioned events/projections" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=2;fontSize=13;fontColor=#0f172a;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="1415" width="2330" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
