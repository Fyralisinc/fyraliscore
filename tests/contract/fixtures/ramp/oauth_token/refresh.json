{
  "_meta": {
    "provider": "ramp",
    "kind": "oauth_token",
    "description": "Ramp OAuth 2.0 refresh-token exchange. POST to the Ramp token endpoint with HTTP Basic auth (base64(client_id:client_secret)) and a form body grant_type=refresh_token + refresh_token. Returns a new access_token (expires_in ~7200s), a (possibly rotated) refresh_token, and the granted scope. Doc-derived; tokens are placeholders.",
    "source": "doc:https://docs.ramp.com/developer-api/v1/authorization (POST /developer/v1/token, Basic client auth, grant_type=refresh_token; response access_token/refresh_token/expires_in/token_type/scope)",
    "captured_at": "2026-06-09",
    "sanitized": true
  },
  "request": {
    "url": "https://api.ramp.com/developer/v1/token",
    "method": "POST",
    "auth": "basic",
    "headers": {
      "Authorization": "Basic <base64(client_id:client_secret)>",
      "Content-Type": "application/x-www-form-urlencoded",
      "Accept": "application/json"
    },
    "form": {
      "grant_type": "refresh_token",
      "refresh_token": "ramp_rt_old_placeholder_0000"
    }
  },
  "response": {
    "status": 200,
    "body": {
      "access_token": "ramp_at_new_placeholder_1111",
      "token_type": "Bearer",
      "expires_in": 7200,
      "refresh_token": "ramp_rt_rotated_placeholder_2222",
      "scope": "transactions:read users:read business:read"
    }
  }
}
