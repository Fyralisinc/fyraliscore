# Copy this file to `.env` and fill in the secrets. Never commit `.env`.
# `.env` is gitignored; only `.env.example` should ever be tracked.
#
# A second-tier overlay file `.env.dogfood` is also gitignored and is
# loaded on top of `.env` by scripts/dogfood_up.sh. Both files are
# templated below — split values into the file that fits.

# =====================================================================
# Core: Postgres + Ollama
# =====================================================================

# Local Postgres (pgvector). Brought up by `docker compose up -d postgres`.
DATABASE_URL=postgresql://company_os:company_os@localhost:5432/company_os

# Local Ollama for embeddings. Brought up by `docker compose up -d ollama`,
# or run natively via `ollama serve`.
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# =====================================================================
# LLM provider
# =====================================================================
# One of: anthropic | openai | deepseek | codex
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=30

# Provider keys. Only the one matching LLM_PROVIDER is required.
# Generic fallback (used when the provider-specific key is unset).
LLM_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Codex provider:
#   LLM_PROVIDER=codex
#   CODEX_TRANSPORT=auto
#   CODEX_MODEL=        # Optional. Local app-server/CLI defaults to ~/.codex/config.toml.
# Auth order is CODEX_API_KEY -> OPENAI_API_KEY -> LLM_API_KEY ->
# ~/.codex/auth.json. For local dogfood, `codex login` creates the
# auth file and auto-routes through a persistent subscription-backed
# Codex app-server. Use CODEX_MODEL, not LLM_MODEL, to override the
# Codex CLI model for local dogfood.
# Production should mount a platform API key and use CODEX_TRANSPORT=responses.
CODEX_API_KEY=
CODEX_MODEL=
CODEX_TRANSPORT=
CODEX_REASONING_EFFORT=
CODEX_HOME=
CODEX_AUTH_FILE=
CODEX_ACCOUNT_ID=

# Retrieval question planning is latency-sensitive. When LLM_PROVIDER=codex,
# the planner uses a dedicated small Codex low-effort provider by default.
INQUIRY_CODEX_LOW_EFFORT_QUESTION_PLANNING=1
INQUIRY_CODEX_QUESTION_MODEL=gpt-5.3-codex-spark
INQUIRY_CODEX_QUESTION_TIMEOUT_SECONDS=24
INQUIRY_CODEX_QUESTION_MAX_TOKENS=
INQUIRY_CODEX_QUESTION_MAX_RETRIES=0
INQUIRY_CODEX_COMPACT_QUESTION_SCHEMA=1

# Learned retrieval motifs compose existing safe retrieval operators into
# reusable staged recipes. They never execute arbitrary SQL.
INQUIRY_RETRIEVAL_MOTIFS_ENABLED=1
INQUIRY_RETRIEVAL_MOTIFS_LEARNING_ENABLED=1
INQUIRY_RETRIEVAL_MOTIF_FAILURE_LEARNING_ENABLED=1
INQUIRY_RETRIEVAL_MOTIF_MIN_SUCCESSES=1
INQUIRY_RETRIEVAL_MOTIF_MAX_ACTIONS=5
INQUIRY_RETRIEVAL_MOTIF_MATCH_THRESHOLD=0.34
INQUIRY_RETRIEVAL_MOTIF_QUARANTINE_FAILURES=3
INQUIRY_RETRIEVAL_MOTIF_QUARANTINE_UTILITY=0.0
INQUIRY_RETRIEVAL_MOTIF_NOISY_OMISSION_MIN=6
INQUIRY_RETRIEVAL_MOTIF_WIDE_MODEL_THRESHOLD=80

# Optional: raise the per-call ceiling for slow real-LLM runs (ms).
# LLM_TIMEOUT_OVERRIDE_MS=120000

# =====================================================================
# Tenant / actor identity
# =====================================================================
# Default tenant for local dev. Production is multi-tenant; do not rely
# on this in non-dev environments.
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
COMPANY_OS_TENANT_ID=00000000-0000-0000-0000-000000000001
COMPANY_OS_CEO_ACTOR_ID=00000000-0000-0000-0000-000000000002

# =====================================================================
# Gateway runtime
# =====================================================================
# Accepted values: dev | staging | test. Enables synthetic-bypass
# guard, sim mount default, and dev-mode middleware shortcuts.
COMPANY_OS_ENV=dev

GATEWAY_PORT=8000
GATEWAY_START_GRT_SCHEDULER=1
GATEWAY_CEO_VIEW_ENABLED=1
# 1 = fail gateway startup if generic WS /stream realtime cannot start.
# Leave 0 when no active browser/external client depends on /stream.
GATEWAY_REQUIRE_REALTIME=0
# 1 = fail gateway startup if GitHub-specific gateway state cannot be wired.
# Leave 0 when GitHub is one optional ingestion provider among others.
GATEWAY_REQUIRE_GITHUB_INTEGRATION=0
# 1 = fail gateway startup when Kafka/S3 ingestion data-plane clients cannot
# be wired. Leave 0 for local dev if Kafka/MinIO are intentionally absent.
GATEWAY_REQUIRE_INGESTION_DATA_PLANE=0
# OAuth install-state cleanup interval in seconds.
GATEWAY_OAUTH_SWEEP_INTERVAL_S=300
# Startup timeout budgets in seconds.
GATEWAY_DB_STARTUP_TIMEOUT_S=30
GATEWAY_INTEGRATION_RUNTIME_PROBE_TIMEOUT_S=5
GATEWAY_REALTIME_STARTUP_TIMEOUT_S=10
GATEWAY_CEO_VIEW_STARTUP_TIMEOUT_S=30
GATEWAY_INGESTION_DATA_PLANE_STARTUP_TIMEOUT_S=30

# CEO view personalisation
VIEW_CEO_DISPLAY_NAME=Rachin
VIEW_CEO_TIMEZONE=Asia/Kathmandu
# Deterministic bearer token so the UI can authenticate without a
# /auth/session round-trip. Keep this off in any shared environment.
DEV_BEARER_TOKEN=dogfood-ceo-token
VIEW_CEO_TOKEN=ceo-dogfood-token

# In-process scheduler / rendering adapters point at the gateway itself
# under the single-port topology used in dev.
GRT_RENDERING_BASE_URL=http://127.0.0.1:8000
QUERY_RENDERING_BASE_URL=http://127.0.0.1:8000
# QUERY_RENDERING_AUTH_TOKEN=
# Cache backend for the query-side rendering adapter: memory | pg.
QUERY_CACHE_BACKEND=pg

# =====================================================================
# Workers
# =====================================================================
THINK_WORKER_POLL_INTERVAL_S=2
# Optional comma-separated Think lane filter for specialized workers.
# Leave unset/empty for the legacy all-lane worker. Valid lanes:
# reflex,batch_memory,relationship,deep_synthesis,repair.
# THINK_WORKER_LANES=
# T1 signal batching. A zero window preserves one-trigger-per-signal behavior.
# When enabled, the default target is 20-30 signals per batch.
THINK_T1_BATCH_WINDOW_S=0
THINK_T1_BATCH_MAX_SIZE=30
THINK_T1_BATCH_MIN_SIZE=20
# Downstream T2/T4 batching. A zero window preserves scalar fanout behavior.
THINK_DOWNSTREAM_BATCH_WINDOW_S=0
THINK_DOWNSTREAM_BATCH_MIN_SIZE=2
THINK_T2_BATCH_MAX_SIZE=8
THINK_T4_BATCH_MAX_SIZE=4
# Model-first context keeps Models as historical memory and uses old
# Observations only as small evidence anchors. Keep trigger cap near
# max T1 batch size so current raw signals are preserved.
RETRIEVAL_MODEL_FIRST_CONTEXT_ENABLED=1
RETRIEVAL_TRIGGER_OBSERVATION_CAP=30
RETRIEVAL_HISTORICAL_OBSERVATION_CAP=4
POST_COMMIT_WORKER_POLL_INTERVAL_S=5
TOPOLOGY_SWEEPER_INTERVAL_S=900
TOPOLOGY_SWEEPER_LIMIT_PER_TENANT=50
TOPOLOGY_SWEEPER_MIN_ACTIVATION=0.15
# How often the greeting refreshes when the dashboard is open (seconds).
GREETING_REFRESH_INTERVAL_SECONDS=900

# =====================================================================
# Execution routing
# =====================================================================
# Shadow mode records route decisions without changing current ingest -> T1 behavior.
EXECUTION_ROUTING_SHADOW=1
EXECUTION_ROUTING_ENABLED=0
EXECUTION_RETRIEVAL_ENGINE=inquiry
INQUIRY_MAX_ROUNDS=2
INQUIRY_QUESTIONS_PER_ROUND=3
INQUIRY_EVIDENCE_RESERVOIR_LIMIT=500
INQUIRY_FAST_PATH_EVIDENCE_LIMIT=50
INQUIRY_REASONING_PACKET_TOKENS=24000
INQUIRY_TEMPORAL_WINDOW_DAYS=30
INQUIRY_SEMANTIC_BUDGET=30

# =====================================================================
# Ingestion: real source integrations (gmail / github / slack / discord)
# =====================================================================
# These are NOT needed for local/dogfood dev (synthetic harness only).
# For a real customer deployment fill them in `.env.production` — see
# `.env.production.example` for the complete, documented schema and the
# data-plane vars (Kafka, S3, MASTER_KEK, watch schedulers, etc.).
# Left here (commented) only so they are discoverable from the dev file.
#
# GitHub App:    GITHUB_APP_ID, GITHUB_APP_PRIVATE_KEY[_PATH],
#                GITHUB_APP_SLUG, WEBHOOK_SECRET_GITHUB
# Slack OAuth:   SLACK_CLIENT_ID, SLACK_CLIENT_SECRET, SLACK_REDIRECT_URI,
#                SLACK_SIGNING_SECRET
# Dev fallback:  WEBHOOK_SECRET_SLACK (only when WEBHOOK_SECRETS_ENV_FALLBACK_ALLOW=1)
# Discord:       DISCORD_BOT_TOKEN, DISCORD_APPLICATION_ID,
#                DISCORD_CLIENT_ID, DISCORD_CLIENT_SECRET,
#                DISCORD_REDIRECT_URI, WEBHOOK_SECRET_DISCORD
# Figma OAuth:   FIGMA_OAUTH_ENABLED, FIGMA_CLIENT_ID, FIGMA_CLIENT_SECRET,
#                FIGMA_REDIRECT_URI, FIGMA_OAUTH_UI_BASE_URL,
#                FIGMA_OAUTH_SCOPES
# Gmail DWD:     GMAIL_SERVICE_ACCOUNT_JSON_FILE, GMAIL_PUBSUB_PROJECT_ID,
#                GMAIL_PUBSUB_PUSH_ENDPOINT, GMAIL_PUBSUB_PUSH_OIDC_AUDIENCE,
#                GMAIL_PUBSUB_PUSH_OIDC_SA
# Secrets:       MASTER_KEK, OAUTH_STATE_HMAC_KEY
# Data plane:    KAFKA_BOOTSTRAP_SERVERS, S3_ENDPOINT_URL, S3_RAW_BUCKET,
#                S3_BLOB_BUCKET
KAFKA_BOOTSTRAP_SERVERS=
S3_ENDPOINT_URL=
S3_RAW_BUCKET=fyralis-raw
S3_BLOB_BUCKET=fyralis-blobs

# =====================================================================
# Auth bootstrap
# =====================================================================
# When set, POST /auth/session requires the X-Bootstrap-Secret header
# to match. When unset, /auth/session accepts any body (dev only).
AUTH_BOOTSTRAP_SECRET=

# =====================================================================
# Observability / debug
# =====================================================================
LOG_LEVEL=INFO
# Gates think_run_artifacts capture and the /debug/* endpoints. Dev only.
DEBUG_ARTIFACT_CAPTURE=1
