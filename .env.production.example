# =====================================================================
# .env.production.example — production template for a real deployment
# =====================================================================
# Copy to `.env.production` (gitignored) on the deploy host and fill in.
# `docker-compose.yml` loads this via `env_file:` for gateway + workers.
#
# Anything marked REQUIRED must be set or the relevant feature fails
# closed (the gateway refuses to boot, or the source is simply not
# ingested). Anything marked OPTIONAL has a safe default.
#
# Security posture: with COMPANY_OS_ENV=prod / FYRALIS_ENV=prod, the
# gateway hard-refuses the synthetic /simulation/* injection router,
# requires a managed MASTER_KEK provider, and fails closed on missing
# webhook secrets.

# ---------------------------------------------------------------------
# Environment + core infra  (REQUIRED)
# ---------------------------------------------------------------------
COMPANY_OS_ENV=prod
FYRALIS_ENV=prod
GATEWAY_START_GRT_SCHEDULER=1

DATABASE_URL=postgresql://company_os:company_os@postgres:5432/company_os
REDIS_URL=redis://redis:6379/0
# Set to 1 when DATABASE_URL points at transaction-mode pgbouncer; this
# disables asyncpg prepared-statement caching for gateway and worker pools.
POSTGRES_PGBOUNCER_COMPATIBLE=0
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_IN_TRANSACTION_SESSION_TIMEOUT_MS=60000
OLLAMA_URL=http://ollama:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# Product rendering (REQUIRED for CEO/greeting and Query/Ask surfaces in prod).
# The gateway refuses to serve MockRenderingAdapter output when these are unset.
GRT_RENDERING_BASE_URL=http://gateway:8000
QUERY_RENDERING_BASE_URL=http://gateway:8000
# QUERY_RENDERING_AUTH_TOKEN=
QUERY_CACHE_BACKEND=pg

# Think + question-planning LLMs (REQUIRED)
# Production preserves one app path:
#   - Think main reasoning: Codex, using CODEX_MODEL / CODEX_REASONING_EFFORT.
#   - Inquiry question planning: dedicated low-effort Codex spark model below.
# Do not set generic LLM_MODEL or non-Codex provider keys in prod; they make it
# ambiguous which model the worker is using.
LLM_PROVIDER=codex
LLM_STRICT_CONFIG=1
CODEX_API_KEY=
CODEX_TRANSPORT=responses
CODEX_MODEL=gpt-5.5
CODEX_REASONING_EFFORT=medium
INQUIRY_CODEX_QUESTION_MODEL=gpt-5.3-codex-spark
INQUIRY_CODEX_QUESTION_TIMEOUT_SECONDS=24
INQUIRY_CODEX_QUESTION_MAX_RETRIES=0
INQUIRY_CODEX_QUESTION_MAX_TOKENS=900

# ---------------------------------------------------------------------
# Think cost optimization. Batching defaults ON, prompt layout is always
# cache-friendly, and other quality-affecting flags default off/no-change. See
# docs/reference/THINK-COST-ROLLOUT.md.
# ---------------------------------------------------------------------
# Lean the JSON-shape prose when the provider enforces the schema. Codex treats
# schemas as hints, so this should normally stay off.
# THINK_STRICT_LEAN_PROMPT=0
# Per-section prompt char budgets (defaults shown = historical hardcoded values).
# THINK_OBS_CHAR_BUDGET=4000
# THINK_MODELS_CHAR_BUDGET=4000
# THINK_ACTS_CHAR_BUDGET=12000
# THINK_RESOURCES_CHAR_BUDGET=1000
# THINK_CANDIDATES_CHAR_BUDGET=12000
# Validation-failure retry cap + feedback loop (unset = no change). When set,
# validation-class failures dead-letter after N attempts and the validator's
# feedback is appended to the retry prompt.
# THINK_VALIDATION_MAX_ATTEMPTS=
# Model to escalate to on a validation retry (unset = no escalation, retry on
# the same model with feedback). Requires THINK_VALIDATION_MAX_ATTEMPTS > 1.
# THINK_ESCALATION_MODEL=
# Reuse the prior raw_diff on a deadlock/serialization retry when the rebuilt
# context bundle is unchanged (skips the main LLM call). Off by default.
# THINK_REUSE_DIFF_ON_TX_RETRY=0
# Inferential Think triggers must keep retrieval/planning + LLM reasoning
# outside the mutation transaction; only validation/apply/cascade hold DB locks.
THINK_NARROW_INFERENTIAL_TX=1
# Tighter cross-trigger inferential-lineage depth bound (unset = the hard
# MAX_CASCADE_DEPTH). Observe the lineage distribution before tightening.
# THINK_MAX_INFERENTIAL_LINEAGE_DEPTH=
# Skip retrieval+reasoning for an already-applied trigger (pre-check).
# THINK_EARLY_IDEMPOTENCY_SKIP=0
# Comma-separated trigger classes (kind or kind:subkind) that use single-round
# "fast" planning instead of "deep" (cuts T1 question-planning spend).
# THINK_FAST_PLAN_TRIGGER_KINDS=
# Batch-first Think dispatch. Set a window to 0 to disable that batch class
# and process ready rows singly. T1 arrivals below min size fall back to
# singles after the window expires, so low-volume tenants do not stall.
# THINK_T1_BATCH_WINDOW_S=30
# THINK_T1_BATCH_MIN_SIZE=20
# THINK_T1_BATCH_MAX_SIZE=30
# THINK_DOWNSTREAM_BATCH_WINDOW_S=60
# THINK_DOWNSTREAM_BATCH_MIN_SIZE=2
# THINK_T2_BATCH_MAX_SIZE=8
# THINK_T4_BATCH_MAX_SIZE=4
# Prompt-facing retrieval context. Models are the memory substrate by default;
# raw observations are emitted only when selected Models are missing. Use
# "always" only for rollback/debugging, and "none" for strict model-only probes.
# RETRIEVAL_OBSERVATION_CONTEXT_MODE=model_gap
# RETRIEVAL_OBSERVATION_CONTEXT_MIN_MODELS=1
# RETRIEVAL_TRIGGER_OBSERVATION_CAP=30
# RETRIEVAL_HISTORICAL_OBSERVATION_CAP=4
# Inquiry packet evidence policy. "model_first" keeps Models, action anchors,
# and counterevidence; redundant observation cards are suppressed.
# INQUIRY_CONTEXT_PACKET_EVIDENCE_MODE=model_first
# Batch prompt-facing context caps. These trim model budget and historical
# observation fallback rows selected alongside a T1 event batch.
# THINK_BATCH_CONTEXT_MODEL_BUDGET=16
# THINK_BATCH_HISTORICAL_OBSERVATION_CAP=2
# Per-tenant daily LLM spend/token/request ceilings. Requires the enforcement
# flag; on breach the worker pauses that tenant's dispatch (never dead-letters).
# THINK_DAILY_BUDGET_ENFORCEMENT=0
# LLM_DAILY_BUDGET_USD_PER_TENANT=
# LLM_DAILY_TOKEN_BUDGET_PER_TENANT=
# LLM_DAILY_REQUEST_BUDGET_PER_TENANT=

# ---------------------------------------------------------------------
# Secret store + auth  (REQUIRED)
# ---------------------------------------------------------------------
# Secret store backend is the opaque `secret_ref` implementation. `fernet`
# keeps encrypted source credentials in Postgres and resolves the wrapping key
# through MASTER_KEK_PROVIDER below.
SECRET_STORE_BACKEND=fernet
# Supported production values:
#   aws-secrets-manager, gcp-secret-manager, hashicorp-vault.
# `env` is a local/dev compatibility path and is rejected in production.
MASTER_KEK_PROVIDER=aws-secrets-manager
MASTER_KEK_SECRET_REF=prod/fyralis/master-kek
SECRET_PROVIDER_REGION=us-east-1
# SECRET_PROVIDER_ENDPOINT=
# For HashiCorp Vault, set SECRET_PROVIDER_ENDPOINT and VAULT_TOKEN via the
# platform's secret injection mechanism. Do not commit VAULT_TOKEN.
SECRET_PROVIDER_TIMEOUT_SECONDS=5
# 32-byte url-safe base64 Fernet key. Generate once, store in the managed
# provider referenced above, and DO NOT regenerate or every encrypted secret
# becomes unrecoverable. Do not set raw MASTER_KEK in production.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# HMAC key for single-use OAuth state tokens. Missing in prod → install
# flow fails closed.
OAUTH_STATE_HMAC_KEY=
# Required header secret for POST /auth/session. Runtime rejects missing,
# short (<32 chars), or known-placeholder values in production.
AUTH_BOOTSTRAP_SECRET=
# Sensitive control planes must be explicitly disabled in production.
DEBUG_ENDPOINTS_ENABLED=0
FINANCE_PANEL_ENABLED=false
SLACK_DM_PANEL_ENABLED=false
SPEC_DEMO_ROUTES_ENABLED=0
WEBSOCKET_QUERY_TOKEN_AUTH_ENABLED=0
WEBSOCKET_SESSION_COOKIE_NAME=fyralis_session
VIEW_CEO_STATIC_TOKENS_ENABLED=0
GATEWAY_MOUNT_SIM=0
# Must stay unset/0 in prod (the gateway refuses to boot if =1 in prod).
WEBHOOK_SECRETS_ENV_FALLBACK_ALLOW=0

# ---------------------------------------------------------------------
# Kafka data plane + S3 raw store  (REQUIRED for backfill + Kafka path)
# ---------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# Generic WS /stream is optional unless external/product clients depend on it.
GATEWAY_REQUIRE_REALTIME=0
# GitHub provider state is optional unless this deployment promises GitHub UX.
GATEWAY_REQUIRE_GITHUB_INTEGRATION=0
# Fail gateway startup if Kafka/S3 data-plane clients cannot be wired.
GATEWAY_REQUIRE_INGESTION_DATA_PLANE=1
# OAuth install-state cleanup interval in seconds.
GATEWAY_OAUTH_SWEEP_INTERVAL_S=300
# Startup timeout budgets in seconds.
GATEWAY_DB_STARTUP_TIMEOUT_S=30
GATEWAY_POSTGRES_POOL_SIZE=10
GATEWAY_INTEGRATION_RUNTIME_PROBE_TIMEOUT_S=5
GATEWAY_REALTIME_STARTUP_TIMEOUT_S=10
GATEWAY_CEO_VIEW_STARTUP_TIMEOUT_S=30
GATEWAY_INGESTION_DATA_PLANE_STARTUP_TIMEOUT_S=30
# Object store for raw event bodies (S3 / MinIO). For real S3 omit
# S3_ENDPOINT_URL and use the AWS default endpoint + IAM creds.
S3_ENDPOINT_URL=
S3_RAW_BUCKET=fyralis-raw
S3_REGION_NAME=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Embedder backend for the embedding worker. REQUIRED in production; the
# factory refuses implicit backend selection under prod. 'ollama' is
# local + free (the in-cluster ollama service, nomic-embed-text → 768d).
# Set 'openai' to use the cloud embedding backend instead. This is embedding
# only; Think/question planning still use CODEX_API_KEY above.
# OPENAI_EMBED_MODEL/OPENAI_EMBED_DIM default to text-embedding-3-small@768
# to match the VECTOR(768) column.
EMBEDDER_BACKEND=ollama
# Backend-level batch fan-out caps. Keep these <= the backend's sustainable
# parallel request budget; worker-level EMBEDDING_MAX_CONCURRENCY is separate.
OLLAMA_EMBED_MAX_CONCURRENCY=4
# OPENAI_API_KEY=
# OPENAI_EMBED_MODEL=text-embedding-3-small
# OPENAI_EMBED_DIM=768
# OPENAI_EMBED_MAX_CONCURRENT_REQUESTS=4

# Ingestion throughput tuning (OPTIONAL).
# These defaults keep durability intact while removing single-message
# bottlenecks: workers overlap independent I/O, writers consume in batches,
# and request-path flushes coalesce for a few milliseconds under load.
NORMALIZER_NUM_WORKERS=2
NORMALIZER_MAX_CONCURRENCY=16
WRITER_BATCH_SIZE=100
WRITER_BATCH_TIMEOUT_MS=250
WRITER_MAX_CONCURRENCY=8
WRITER_POSTGRES_POOL_SIZE=24
EMBEDDING_MAX_CONCURRENCY=4
POSTGRES_POOL_SIZE=8
THINK_POSTGRES_POOL_SIZE=8
POST_COMMIT_POSTGRES_POOL_SIZE=4
HOUSEKEEPER_POSTGRES_POOL_SIZE=4
MAINTENANCE_POSTGRES_POOL_SIZE=3
SOURCE_GATEWAY_POSTGRES_POOL_SIZE=4
SOURCE_SCHEDULER_POSTGRES_POOL_SIZE=8
EXTENSION_WORKERS_POOL_MAX=4
# Debug/quality artifacts can include prompts, responses, validation payloads,
# and other high-volume JSONB. Keep capture disabled in production by default,
# and expire any retained artifacts through the housekeeper worker.
THINK_RUN_ARTIFACT_RETENTION_DAYS=30
THINK_RUN_ARTIFACT_RETENTION_BATCH_SIZE=5000
THINK_RUN_ARTIFACT_RETENTION_DRY_RUN=0
HOUSEKEEPER_THINK_ARTIFACT_RETENTION_INTERVAL_S=86400
HOUSEKEEPER_BACKUP_RECOVERY_METRICS_INTERVAL_S=300
HOUSEKEEPER_DB_ACTIVITY_METRICS_INTERVAL_S=60
DB_LONG_TRANSACTION_ALERT_THRESHOLD_SECONDS=300
BACKUP_POSTGRES_FRESHNESS_SLO_SECONDS=129600
BACKUP_OBJECT_STORE_FRESHNESS_SLO_SECONDS=129600
RESTORE_TEST_FRESHNESS_SLO_SECONDS=3024000
KAFKA_FLUSH_BATCH_MAX_DELAY_MS=10
SHARD_FETCH_RATE_LIMIT=1
SHARD_FETCH_RATE_LIMIT_MAX_WAIT_SEC=30
SLACK_API_TIER=3
# Source API 429 / Retry-After budgets. The clients honor Retry-After and cap
# per-call sleep so a provider throttle parks work instead of wedging workers.
ASHBY_RL_MAX_ATTEMPTS=4
ASHBY_RL_MAX_SLEEP_SEC=30
AWS_RL_MAX_ATTEMPTS=4
BREX_RL_MAX_ATTEMPTS=4
BREX_RL_MAX_SLEEP_SEC=30
CARTA_RL_MAX_ATTEMPTS=4
CARTA_RL_MAX_SLEEP_SEC=30
DEEL_RL_MAX_ATTEMPTS=4
DEEL_RL_MAX_SLEEP_SEC=30
FIGMA_RL_MAX_ATTEMPTS=4
FIGMA_RL_MAX_SLEEP_SEC=30
FIREFLIES_RL_MAX_ATTEMPTS=4
FIREFLIES_RL_MAX_SLEEP_SEC=30
GITHUB_RL_MAX_ATTEMPTS=4
GITHUB_RL_MAX_SLEEP_SEC=30
GRAFANA_RL_MAX_ATTEMPTS=4
GRAFANA_RL_MAX_SLEEP_SEC=30
GUSTO_RL_MAX_ATTEMPTS=4
GUSTO_RL_MAX_SLEEP_SEC=30
HIBOB_RL_MAX_ATTEMPTS=4
HIBOB_RL_MAX_SLEEP_SEC=30
JIRA_RL_MAX_ATTEMPTS=4
JIRA_RL_MAX_SLEEP_SEC=30
LINKEDIN_RL_MAX_ATTEMPTS=4
LINKEDIN_RL_MAX_SLEEP_SEC=30
MERCURY_RL_MAX_ATTEMPTS=4
MERCURY_RL_MAX_SLEEP_SEC=30
MIRO_RL_MAX_ATTEMPTS=4
MIRO_RL_MAX_SLEEP_SEC=30
NOTION_RL_MAX_ATTEMPTS=4
NOTION_RL_MAX_SLEEP_SEC=30
QUICKBOOKS_RL_MAX_ATTEMPTS=4
QUICKBOOKS_RL_MAX_SLEEP_SEC=30
RAMP_RL_MAX_ATTEMPTS=4
RAMP_RL_MAX_SLEEP_SEC=30
GMAIL_HISTORY_POLLER_MAX_CONCURRENCY=8
GOOGLE_CALENDAR_LIVE_POLLER_MAX_CONCURRENCY=8
GOOGLE_DRIVE_LIVE_POLLER_MAX_CONCURRENCY=8
SHARD_FETCH_CONCURRENCY=4
SHARD_FETCH_S3_WRITE_CONCURRENCY=32

# Backfill workflow tuning (OPTIONAL).
# RECONCILER_TICK_SEC=15
# SHARD_FETCH_TICK_SEC=5
# RECONCILER_DISPATCH_TIMEOUT_SEC=30

# Periodic re-reconciliation (steady-state gap recovery, OPTIONAL).
# Re-checks each settled run for missed live events at most every
# MIN_AGE seconds. Lower MIN_AGE = tighter recovery, more API calls.
# PERIODIC_RECONCILE_TICK_SEC=300
# PERIODIC_RECONCILE_MIN_AGE_SEC=21600
# PERIODIC_RECONCILE_BATCH=20

# Ops alert webhook (Slack/PagerDuty/generic). Receives circuit-breaker
# trips and DLQ-depth alerts. Unset = log-only.
# INGESTION_ALERT_WEBHOOK_URL=
# DLQ-depth alerting (OPTIONAL). Page via INGESTION_ALERT_WEBHOOK_URL
# when unresolved ingestion_failures reach the threshold. 0 = off.
# DLQ_DEPTH_ALERT_THRESHOLD=0
# DLQ_DEPTH_CHECK_INTERVAL_SEC=60
# DLQ_DEPTH_ALERT_COOLDOWN_SEC=3600

# ---------------------------------------------------------------------
# Observability stack  (OPTIONAL — opt-in)
# ---------------------------------------------------------------------
# Prometheus/Grafana/exporters are gated behind the compose `observability`
# profile (a plain `docker compose up` does NOT start them):
#   docker compose --profile observability up -d
# Workers always expose /healthz + /metrics on INGESTION_HEALTH_PORT; only the
# scrape/dashboard side is gated, so small boxes can skip the 5-container stack.
#
# Per-worker liveness + metrics HTTP server port. Compose sets 9300 for every
# container; set it explicitly only when running workers OUTSIDE compose
# (0 / unset = no server bound). The consumer healthcheck + prometheus scrape
# both target this port.
# INGESTION_HEALTH_PORT=9300
# /healthz returns 503 once the worker heartbeat is older than this (seconds).
# INGESTION_HEALTH_STALE_SEC=120
# Grafana admin password — REQUIRED when observability profile is enabled.
# Compose has a known weak fallback for local bring-up only; production env
# contract rejects that default. Grafana carries a Postgres datasource with
# tenant-data read access; keep it behind the TLS/auth edge.
GRAFANA_ADMIN_PASSWORD=change-me-min-32-random-chars
# Host-port overrides (loopback-only binds) if 9090/3000 already taken.
# PROMETHEUS_HOST_PORT=9090
# GRAFANA_HOST_PORT=3000

# ---------------------------------------------------------------------
# GitHub App  (REQUIRED for github ingestion)
# ---------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Provide exactly ONE of these (PEM contents, or a mounted file path).
GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github_app.pem
# Webhook HMAC secret(s), comma-separated for rotation.
WEBHOOK_SECRET_GITHUB=
# WEBHOOK_SECRET_GITHUB_PREV=
# If the App is granted on >90 repos, raise this (0 = no cap).
# GITHUB_MAX_BACKFILL_REPOS=0

# ---------------------------------------------------------------------
# Slack OAuth app  (REQUIRED for slack ingestion)
# ---------------------------------------------------------------------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://your-host/integrations/slack/callback
# Event-API signing secret (HMAC). Stored encrypted during OAuth install.
SLACK_SIGNING_SECRET=
# Dev/env fallback only; keep empty in prod while
# WEBHOOK_SECRETS_ENV_FALLBACK_ALLOW=0.
# WEBHOOK_SECRET_SLACK=
# SLACK_MAX_TIMESTAMP_AGE_S=300
# Include private channels in backfill (default public only).
# SLACK_BACKFILL_INCLUDE_PRIVATE=0

# ---------------------------------------------------------------------
# Discord app + bot  (REQUIRED for discord ingestion)
# ---------------------------------------------------------------------
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://your-host/integrations/discord/callback
# Ed25519 public key for interaction signature verification.
WEBHOOK_SECRET_DISCORD=
# DISCORD_MAX_TIMESTAMP_AGE_S=300
# Pin so the channel-sampling set is stable across restarts.
PYTHONHASHSEED=0

# ---------------------------------------------------------------------
# Gmail (Domain-Wide Delegation + Pub/Sub push)  (REQUIRED for gmail)
# ---------------------------------------------------------------------
# Mounted service-account JSON (preferred over inline JSON).
GMAIL_SERVICE_ACCOUNT_JSON_FILE=/run/secrets/gmail_sa.json
# GMAIL_SERVICE_ACCOUNT_JSON=
GMAIL_SERVICE_ACCOUNT_CLIENT_ID=
GMAIL_PUBSUB_PROJECT_ID=
GMAIL_PUBSUB_PUSH_ENDPOINT=https://your-host/webhooks/gmail/pubsub
# OIDC claims the push endpoint verifies (fail closed if unset).
GMAIL_PUBSUB_PUSH_OIDC_AUDIENCE=https://your-host/webhooks/gmail/pubsub
GMAIL_PUBSUB_PUSH_OIDC_SA=

# ---------------------------------------------------------------------
# Multi-tenant  (do NOT set a default tenant in prod)
# ---------------------------------------------------------------------
# WEBHOOK_TENANT_DEFAULT_ALLOW must stay unset/0: webhooks resolve the
# tenant from the installation, never a hardcoded default.
WEBHOOK_TENANT_DEFAULT_ALLOW=0

LOG_LEVEL=INFO
DEBUG_ARTIFACT_CAPTURE=0
